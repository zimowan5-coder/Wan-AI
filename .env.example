# Wan's AI Business OS v0.1 环境变量说明
# 复制为 .env 后填写。注意：消费者订阅（ChatGPT Plus / Claude Pro）不等于 API 额度，
# 下面这些 Key 是按量付费的 API Key，不填则对应功能不可用（任务会转人工流程），不会悄悄扣费。

# OpenAI API Key（留空=不可用）
OPENAI_API_KEY=
# Anthropic API Key（留空=不可用）
ANTHROPIC_API_KEY=
# Gemini API Key（留空=不可用）
GEMINI_API_KEY=

# 默认模型：local（本地规则引擎，零费用）/ openai / anthropic / gemini
WANAI_LLM_PROVIDER=local
