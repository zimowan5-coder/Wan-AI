# Wan's AI Business OS v0.1 环境变量说明
# 复制为 .env 后填写。注意：消费者订阅（ChatGPT Plus / Claude Pro）不等于 API 额度，
# 下面这些 Key 是按量付费的 API Key，不填则对应功能不可用（任务会转人工流程），不会悄悄扣费。

# OpenAI API Key（留空=不可用）
OPENAI_API_KEY=
# Anthropic API Key（留空=不可用）
ANTHROPIC_API_KEY=
# Gemini API Key（留空=不可用）
GEMINI_API_KEY=

# 默认模型：local（本地规则引擎，零费用）/ openai / anthropic / gemini
WANAI_LLM_PROVIDER=local

# ⚠️ 不要把下面的密钥提交到 GitHub。公网部署必须设置管理密码。
WANAI_ADMIN_PASSWORD=
# 仅用于你自己拥有或获授权处理的业务邮箱；建议使用单独的应用密码
WANAI_IMAP_HOST=
WANAI_IMAP_PORT=993
WANAI_IMAP_USER=
WANAI_IMAP_PASSWORD=
WANAI_SMTP_HOST=
WANAI_SMTP_PORT=587
WANAI_SMTP_USER=
WANAI_SMTP_PASSWORD=
WANAI_FROM_EMAIL=
# 独立站表单应在服务端按请求原始 JSON 计算 HMAC-SHA256，填入 X-Wanai-Signature
WANAI_INTAKE_SECRET=
# 使用你自己的 Stripe 商户后台创建真实 Payment Link（仅展示链接，不会自动扣款）
WANAI_CHECKOUT_URL=
STRIPE_WEBHOOK_SECRET=

# 付费模型默认禁用，只有手动写入 I_ACCEPT_PAID_API_COSTS 才允许消费 API；
# 仍须自己监控服务商实际账单，不能将本地估算视为账单硬上限。
WANAI_ENABLE_PAID_AI=
